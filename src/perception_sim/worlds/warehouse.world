<?xml version="1.0"?>
<sdf version="1.6">
  <world name="warehouse">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>
    <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.7 0.75 0.8 1</background></scene>

    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>50.0</update_rate>
    </plugin>

    <model name="walls">
      <static>true</static>
      <link name="link">
        <collision name="wall_px_c"><pose>10.0 0.0 1.250 0 0 0</pose><geometry><box><size>0.2 14.2 2.5</size></box></geometry></collision>
        <visual name="wall_px_v"><pose>10.0 0.0 1.250 0 0 0</pose><geometry><box><size>0.2 14.2 2.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <collision name="wall_nx_c"><pose>-10.0 0.0 1.250 0 0 0</pose><geometry><box><size>0.2 14.2 2.5</size></box></geometry></collision>
        <visual name="wall_nx_v"><pose>-10.0 0.0 1.250 0 0 0</pose><geometry><box><size>0.2 14.2 2.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <collision name="wall_py_c"><pose>0.0 7.0 1.250 0 0 0</pose><geometry><box><size>20.2 0.2 2.5</size></box></geometry></collision>
        <visual name="wall_py_v"><pose>0.0 7.0 1.250 0 0 0</pose><geometry><box><size>20.2 0.2 2.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <collision name="wall_ny_c"><pose>0.0 -7.0 1.250 0 0 0</pose><geometry><box><size>20.2 0.2 2.5</size></box></geometry></collision>
        <visual name="wall_ny_v"><pose>0.0 -7.0 1.250 0 0 0</pose><geometry><box><size>20.2 0.2 2.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
      </link>
    </model>
    <model name="shelf_nw">
      <static>true</static>
      <pose>-3.5 3.0 1.000 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>5.0 1.0 2.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>5.0 1.0 2.0</size></box></geometry>
          <material><ambient>0.5 0.4 0.3 1</ambient><diffuse>0.6 0.5 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="shelf_ne">
      <static>true</static>
      <pose>3.5 3.0 1.000 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>5.0 1.0 2.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>5.0 1.0 2.0</size></box></geometry>
          <material><ambient>0.5 0.4 0.3 1</ambient><diffuse>0.6 0.5 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="shelf_sw">
      <static>true</static>
      <pose>-3.5 -3.0 1.000 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>5.0 1.0 2.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>5.0 1.0 2.0</size></box></geometry>
          <material><ambient>0.5 0.4 0.3 1</ambient><diffuse>0.6 0.5 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="shelf_se">
      <static>true</static>
      <pose>3.5 -3.0 1.000 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>5.0 1.0 2.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>5.0 1.0 2.0</size></box></geometry>
          <material><ambient>0.5 0.4 0.3 1</ambient><diffuse>0.6 0.5 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pillar_n">
      <static>true</static>
      <pose>0.0 5.2 1.250 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 0.4 2.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.4 0.4 2.5</size></box></geometry>
          <material><ambient>0.5 0.4 0.3 1</ambient><diffuse>0.6 0.5 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pillar_s">
      <static>true</static>
      <pose>0.0 -5.2 1.250 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 0.4 2.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.4 0.4 2.5</size></box></geometry>
          <material><ambient>0.5 0.4 0.3 1</ambient><diffuse>0.6 0.5 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pallet_1">
      <static>true</static>
      <pose>-5.0 0.0 0.300 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.8 1.2 0.6</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.8 1.2 0.6</size></box></geometry>
          <material><ambient>0.5 0.4 0.3 1</ambient><diffuse>0.6 0.5 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Dynamic objects: two pedestrians and a moving forklift. Their names are read
         from /gazebo/model_states by the auto-labeler to generate ground-truth boxes. -->
    <actor name="pedestrian_1">
      <skin><filename>walk.dae</filename><scale>1.0</scale></skin>
      <animation name="walking"><filename>walk.dae</filename><interpolate_x>true</interpolate_x></animation>
      <script>
        <loop>true</loop>
        <auto_start>true</auto_start>
        <delay_start>0.0</delay_start>
        <trajectory id="0" type="walking">
          <waypoint><time>0</time><pose>-7 2 0 0 0 0</pose></waypoint>
          <waypoint><time>9</time><pose>7 2 0 0 0 0</pose></waypoint>
          <waypoint><time>9.5</time><pose>7 2 0 0 0 3.14159</pose></waypoint>
          <waypoint><time>18</time><pose>-7 2 0 0 0 3.14159</pose></waypoint>
          <waypoint><time>18.5</time><pose>-7 2 0 0 0 0</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <actor name="pedestrian_2">
      <skin><filename>walk.dae</filename><scale>1.0</scale></skin>
      <animation name="walking"><filename>walk.dae</filename><interpolate_x>true</interpolate_x></animation>
      <script>
        <loop>true</loop>
        <auto_start>true</auto_start>
        <delay_start>2.0</delay_start>
        <trajectory id="0" type="walking">
          <waypoint><time>0</time><pose>2 -4 0 0 0 1.5708</pose></waypoint>
          <waypoint><time>7</time><pose>2 4 0 0 0 1.5708</pose></waypoint>
          <waypoint><time>7.5</time><pose>2 4 0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>14</time><pose>2 -4 0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>14.5</time><pose>2 -4 0 0 0 1.5708</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <actor name="forklift_1">
      <link name="body">
        <visual name="v">
          <geometry><box><size>1.2 0.8 1.4</size></box></geometry>
          <material><ambient>0.8 0.5 0.1 1</ambient><diffuse>0.9 0.6 0.1 1</diffuse></material>
        </visual>
        <pose>0 0 0.7 0 0 0</pose>
      </link>
      <script>
        <loop>true</loop>
        <auto_start>true</auto_start>
        <delay_start>0.0</delay_start>
        <trajectory id="0" type="square">
          <waypoint><time>0</time><pose>-6 -4 0 0 0 0</pose></waypoint>
          <waypoint><time>8</time><pose>6 -4 0 0 0 0</pose></waypoint>
          <waypoint><time>9</time><pose>6 -4 0 0 0 1.5708</pose></waypoint>
          <waypoint><time>13</time><pose>6 -1 0 0 0 1.5708</pose></waypoint>
          <waypoint><time>14</time><pose>6 -1 0 0 0 3.14159</pose></waypoint>
          <waypoint><time>22</time><pose>-6 -1 0 0 0 3.14159</pose></waypoint>
          <waypoint><time>23</time><pose>-6 -1 0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>27</time><pose>-6 -4 0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>28</time><pose>-6 -4 0 0 0 0</pose></waypoint>
        </trajectory>
      </script>
    </actor>

  </world>
</sdf>

<?xml version="1.0"?>
<sdf version="1.6">
  <world name="warehouse">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>
    <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.7 0.75 0.8 1</background></scene>

    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>50.0</update_rate>
    </plugin>

    <model name="walls">
      <static>true</static>
      <link name="link">
        <collision name="wall_px_c"><pose>10.0 0.0 1.250 0 0 0</pose><geometry><box><size>0.2 14.2 2.5</size></box></geometry></collision>
        <visual name="wall_px_v"><pose>10.0 0.0 1.250 0 0 0</pose><geometry><box><size>0.2 14.2 2.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <collision name="wall_nx_c"><pose>-10.0 0.0 1.250 0 0 0</pose><geometry><box><size>0.2 14.2 2.5</size></box></geometry></collision>
        <visual name="wall_nx_v"><pose>-10.0 0.0 1.250 0 0 0</pose><geometry><box><size>0.2 14.2 2.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <collision name="wall_py_c"><pose>0.0 7.0 1.250 0 0 0</pose><geometry><box><size>20.2 0.2 2.5</size></box></geometry></collision>
        <visual name="wall_py_v"><pose>0.0 7.0 1.250 0 0 0</pose><geometry><box><size>20.2 0.2 2.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <collision name="wall_ny_c"><pose>0.0 -7.0 1.250 0 0 0</pose><geometry><box><size>20.2 0.2 2.5</size></box></geometry></collision>
        <visual name="wall_ny_v"><pose>0.0 -7.0 1.250 0 0 0</pose><geometry><box><size>20.2 0.2 2.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
      </link>
    </model>
    <model name="shelf_nw">
      <static>true</static>
      <pose>-3.5 3.0 1.000 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>5.0 1.0 2.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>5.0 1.0 2.0</size></box></geometry>
          <material><ambient>0.5 0.4 0.3 1</ambient><diffuse>0.6 0.5 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="shelf_ne">
      <static>true</static>
      <pose>3.5 3.0 1.000 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>5.0 1.0 2.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>5.0 1.0 2.0</size></box></geometry>
          <material><ambient>0.5 0.4 0.3 1</ambient><diffuse>0.6 0.5 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="shelf_sw">
      <static>true</static>
      <pose>-3.5 -3.0 1.000 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>5.0 1.0 2.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>5.0 1.0 2.0</size></box></geometry>
          <material><ambient>0.5 0.4 0.3 1</ambient><diffuse>0.6 0.5 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="shelf_se">
      <static>true</static>
      <pose>3.5 -3.0 1.000 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>5.0 1.0 2.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>5.0 1.0 2.0</size></box></geometry>
          <material><ambient>0.5 0.4 0.3 1</ambient><diffuse>0.6 0.5 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pillar_n">
      <static>true</static>
      <pose>0.0 5.2 1.250 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 0.4 2.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.4 0.4 2.5</size></box></geometry>
          <material><ambient>0.5 0.4 0.3 1</ambient><diffuse>0.6 0.5 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pillar_s">
      <static>true</static>
      <pose>0.0 -5.2 1.250 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 0.4 2.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.4 0.4 2.5</size></box></geometry>
          <material><ambient>0.5 0.4 0.3 1</ambient><diffuse>0.6 0.5 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pallet_1">
      <static>true</static>
      <pose>-5.0 0.0 0.300 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.8 1.2 0.6</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.8 1.2 0.6</size></box></geometry>
          <material><ambient>0.5 0.4 0.3 1</ambient><diffuse>0.6 0.5 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Moving objects. Positioned by perception_tools/agent_mover from
         warehouse.agents.yaml; their names are used for ground-truth labels. -->
    <model name="pedestrian_1">
      <pose>-7.0 1.5 0 0 0 0</pose>
      <link name="body">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <collision name="torso_c"><pose>0 0 0.75 0 0 0</pose><geometry><cylinder><radius>0.22</radius><length>1.5</length></cylinder></geometry><surface><contact><collide_without_contact>true</collide_without_contact></contact></surface></collision>
        <visual name="torso_v"><pose>0 0 0.75 0 0 0</pose><geometry><cylinder><radius>0.22</radius><length>1.5</length></cylinder></geometry>
          <material><ambient>0.2 0.6 0.2 1</ambient><diffuse>0.2 0.7 0.2 1</diffuse></material></visual>
        <collision name="head_c"><pose>0 0 1.65 0 0 0</pose><geometry><sphere><radius>0.13</radius></sphere></geometry><surface><contact><collide_without_contact>true</collide_without_contact></contact></surface></collision>
        <visual name="head_v"><pose>0 0 1.65 0 0 0</pose><geometry><sphere><radius>0.13</radius></sphere></geometry>
          <material><ambient>0.9 0.75 0.6 1</ambient><diffuse>0.9 0.75 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pedestrian_2">
      <pose>0.0 -4.5 0 0 0 1.5708</pose>
      <link name="body">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <collision name="torso_c"><pose>0 0 0.75 0 0 0</pose><geometry><cylinder><radius>0.22</radius><length>1.5</length></cylinder></geometry><surface><contact><collide_without_contact>true</collide_without_contact></contact></surface></collision>
        <visual name="torso_v"><pose>0 0 0.75 0 0 0</pose><geometry><cylinder><radius>0.22</radius><length>1.5</length></cylinder></geometry>
          <material><ambient>0.2 0.3 0.7 1</ambient><diffuse>0.2 0.3 0.8 1</diffuse></material></visual>
        <collision name="head_c"><pose>0 0 1.65 0 0 0</pose><geometry><sphere><radius>0.13</radius></sphere></geometry><surface><contact><collide_without_contact>true</collide_without_contact></contact></surface></collision>
        <visual name="head_v"><pose>0 0 1.65 0 0 0</pose><geometry><sphere><radius>0.13</radius></sphere></geometry>
          <material><ambient>0.9 0.75 0.6 1</ambient><diffuse>0.9 0.75 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="forklift_1">
      <pose>-7.0 -4.3 0 0 0 0</pose>
      <link name="body">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <collision name="body_c"><pose>0 0 0.7 0 0 0</pose><geometry><box><size>1.2 0.8 1.4</size></box></geometry><surface><contact><collide_without_contact>true</collide_without_contact></contact></surface></collision>
        <visual name="body_v"><pose>0 0 0.7 0 0 0</pose><geometry><box><size>1.2 0.8 1.4</size></box></geometry>
          <material><ambient>0.8 0.5 0.1 1</ambient><diffuse>0.9 0.6 0.1 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>

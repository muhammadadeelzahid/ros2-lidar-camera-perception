<?xml version="1.0"?>
<!-- Test terrain for the rollover warning: side-slope pads at 4, 8 and 12 degrees and a
     strip of 2 cm bumps. The pads are tilted about x and raised clear of the ground, so a
     robot placed on a pad facing +x is driving across the slope with its left side up.
     Pad top centres (place the robot there with the pad's roll):
       slope_04  x 10  y 0  z 0.449  roll 0.0698
       slope_08  x 20  y 0  z 0.585  roll 0.1396
       slope_12  x 30  y 0  z 0.719  roll 0.2094 -->
<sdf version="1.6">
  <world name="slopes">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>
    <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.7 0.75 0.8 1</background></scene>
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>50.0</update_rate>
    </plugin>

    <model name="slope_04">
      <static>true</static>
      <pose>10 0 0.2992 0.0698 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>8 4 0.3</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><box><size>8 4 0.3</size></box></geometry>
          <material><ambient>0.55 0.6 0.5 1</ambient><diffuse>0.6 0.65 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="slope_08">
      <static>true</static>
      <pose>20 0 0.4369 0.1396 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>8 4 0.3</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><box><size>8 4 0.3</size></box></geometry>
          <material><ambient>0.6 0.55 0.4 1</ambient><diffuse>0.65 0.6 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="slope_12">
      <static>true</static>
      <pose>30 0 0.5725 0.2094 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>8 4 0.3</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><box><size>8 4 0.3</size></box></geometry>
          <material><ambient>0.65 0.45 0.35 1</ambient><diffuse>0.7 0.5 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Bumps: half-buried cylinders across the path, 2 cm proud of the floor. -->
    <model name="bumps">
      <static>true</static>
      <pose>-10 0 -0.02 0 0 0</pose>
      <link name="link">
        <collision name="b0"><pose>-1.2 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.04</radius><length>3</length></cylinder></geometry></collision>
        <visual name="v0"><pose>-1.2 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.04</radius><length>3</length></cylinder></geometry></visual>
        <collision name="b1"><pose>-0.6 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.04</radius><length>3</length></cylinder></geometry></collision>
        <visual name="v1"><pose>-0.6 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.04</radius><length>3</length></cylinder></geometry></visual>
        <collision name="b2"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.04</radius><length>3</length></cylinder></geometry></collision>
        <visual name="v2"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.04</radius><length>3</length></cylinder></geometry></visual>
        <collision name="b3"><pose>0.6 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.04</radius><length>3</length></cylinder></geometry></collision>
        <visual name="v3"><pose>0.6 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.04</radius><length>3</length></cylinder></geometry></visual>
        <collision name="b4"><pose>1.2 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.04</radius><length>3</length></cylinder></geometry></collision>
        <visual name="v4"><pose>1.2 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.04</radius><length>3</length></cylinder></geometry></visual>
      </link>
    </model>
  </world>
</sdf>

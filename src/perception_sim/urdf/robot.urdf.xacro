<?xml version="1.0"?>
<robot name="ego_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="base_length" value="0.4"/>
  <xacro:property name="base_width" value="0.3"/>
  <xacro:property name="base_height" value="0.15"/>
  <xacro:property name="base_mass" value="5.0"/>

  <xacro:property name="wheel_radius" value="0.06"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="wheel_mass" value="0.5"/>
  <xacro:property name="wheel_separation" value="0.34"/>

  <xacro:property name="camera_size" value="0.03"/>

  <!-- Optional mass on a mast above the LiDAR, like a forklift with its load raised.
       payload_height is measured from the ground; 0 leaves the robot as it is. -->
  <xacro:arg name="payload_height" default="0.0"/>
  <xacro:arg name="payload_mass" default="6.0"/>
  <!-- 2: drive wheels in the middle with casters front and rear (default).
       4: four driven wheels in a rectangle, skid steer; a stance closer to a loader
       or forklift, used for the tip-over tests on slopes. -->
  <xacro:arg name="wheels" default="2"/>
  <xacro:property name="wheels" value="$(arg wheels)"/>
  <xacro:property name="wheel_base" value="0.28"/>
  <xacro:property name="payload_height" value="$(arg payload_height)"/>
  <xacro:property name="payload_mass" value="$(arg payload_mass)"/>

  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m * (y*y + z*z) / 12.0}" ixy="0.0" ixz="0.0"
        iyy="${m * (x*x + z*z) / 12.0}" iyz="0.0"
        izz="${m * (x*x + y*y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m * (3*r*r + h*h) / 12.0}" ixy="0.0" ixz="0.0"
        iyy="${m * (3*r*r + h*h) / 12.0}" iyz="0.0"
        izz="${m * r*r / 2.0}"/>
    </inertial>
  </xacro:macro>

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
      <material name="chassis"><color rgba="0.2 0.3 0.6 1.0"/></material>
    </visual>
    <collision>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
    </collision>
    <xacro:box_inertia m="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}"/>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius + base_height/2.0}" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="wheel" params="prefix y_reflect x:=0.0">
    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="wheel"><color rgba="0.1 0.1 0.1 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="${x} ${y_reflect * wheel_separation/2.0} ${-base_height/2.0}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:if value="${wheels == 2}">
    <xacro:wheel prefix="left" y_reflect="1"/>
    <xacro:wheel prefix="right" y_reflect="-1"/>
  </xacro:if>
  <xacro:if value="${wheels == 4}">
    <xacro:wheel prefix="front_left" y_reflect="1" x="${wheel_base/2.0}"/>
    <xacro:wheel prefix="front_right" y_reflect="-1" x="${wheel_base/2.0}"/>
    <xacro:wheel prefix="rear_left" y_reflect="1" x="${-wheel_base/2.0}"/>
    <xacro:wheel prefix="rear_right" y_reflect="-1" x="${-wheel_base/2.0}"/>
  </xacro:if>

  <!-- Casters front and rear so the body cannot pitch when accelerating or braking. -->
  <xacro:macro name="caster" params="name x_reflect">
    <link name="${name}">
      <visual>
        <geometry><sphere radius="${wheel_radius/2.0}"/></geometry>
        <material name="caster"><color rgba="0.1 0.1 0.1 1.0"/></material>
      </visual>
      <collision>
        <geometry><sphere radius="${wheel_radius/2.0}"/></geometry>
        <surface><friction><ode><mu>0.1</mu><mu2>0.1</mu2></ode></friction></surface>
      </collision>
      <inertial>
        <mass value="0.2"/>
        <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x_reflect * (base_length/2.0 - wheel_radius/2.0)} 0 ${-base_height/2.0 - wheel_radius/2.0}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:if value="${wheels == 2}">
    <xacro:caster name="caster" x_reflect="1"/>
    <xacro:caster name="rear_caster" x_reflect="-1"/>
  </xacro:if>

  <!-- Camera at the front of the chassis, looking forward. -->
  <link name="camera_link">
    <visual>
      <geometry><box size="${camera_size} ${camera_size} ${camera_size}"/></geometry>
      <material name="camera"><color rgba="0.9 0.1 0.1 1.0"/></material>
    </visual>
    <collision>
      <geometry><box size="${camera_size} ${camera_size} ${camera_size}"/></geometry>
    </collision>
    <xacro:box_inertia m="0.05" x="${camera_size}" y="${camera_size}" z="${camera_size}"/>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${base_length/2.0} 0 ${base_height/2.0}" rpy="0 0 0"/>
  </joint>

  <!-- Optical frame: z forward, x right, y down (REP-103). -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- 3D LiDAR on a short mast, the primary detection sensor. Its fixed transform to
       camera_optical_frame is the camera-LiDAR extrinsic used by the fusion node. -->
  <link name="lidar3d_link">
    <visual>
      <geometry><cylinder radius="0.05" length="0.07"/></geometry>
      <material name="lidar"><color rgba="0.1 0.1 0.1 1.0"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.05" length="0.07"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="2e-4" ixy="0" ixz="0" iyy="2e-4" iyz="0" izz="2e-4"/>
    </inertial>
  </link>
  <joint name="lidar3d_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar3d_link"/>
    <origin xyz="0 0 ${base_height/2.0 + 0.12}" rpy="0 0 0"/>
  </joint>

  <!-- IMU at the centre of the chassis. imu_link is where the sensor is meant to be;
       imu_mount is where it actually sits in simulation, about 1 degree off level, so
       there is a mounting error for calibrate_imu to find. -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="imu_mount"/>
  <joint name="imu_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_mount"/>
    <origin xyz="0 0 0" rpy="0.0175 -0.0105 0"/>
  </joint>

  <xacro:if value="${payload_height > 0}">
    <!-- Visual and mass only: no collision, so the LiDAR does not see the mast. -->
    <xacro:property name="mast_bottom" value="${base_height/2.0 + 0.155}"/>
    <xacro:property name="mast_top" value="${payload_height - wheel_radius - base_height/2.0 - 0.1}"/>
    <link name="mast">
      <visual>
        <origin xyz="0 0 ${(mast_top - mast_bottom)/2.0}" rpy="0 0 0"/>
        <geometry><cylinder radius="0.015" length="${mast_top - mast_bottom}"/></geometry>
        <material name="mast"><color rgba="0.6 0.6 0.6 1.0"/></material>
      </visual>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-5"/>
      </inertial>
    </link>
    <joint name="mast_joint" type="fixed">
      <parent link="base_link"/>
      <child link="mast"/>
      <origin xyz="0 0 ${mast_bottom}" rpy="0 0 0"/>
    </joint>
    <link name="payload">
      <visual>
        <geometry><box size="0.2 0.2 0.2"/></geometry>
        <material name="payload"><color rgba="0.9 0.6 0.1 1.0"/></material>
      </visual>
      <xacro:box_inertia m="${payload_mass}" x="0.2" y="0.2" z="0.2"/>
    </link>
    <joint name="payload_joint" type="fixed">
      <parent link="base_link"/>
      <child link="payload"/>
      <origin xyz="0 0 ${payload_height - wheel_radius - base_height/2.0}" rpy="0 0 0"/>
    </joint>
  </xacro:if>

  <xacro:include filename="$(find perception_sim)/urdf/robot.gazebo.xacro"/>

</robot>
